# Free-only story generation is the default. Paid providers are not called unless LLM_FREE_ONLY=false.
# Each provider needs its own key. A free tier still has rate limits and can be exhausted.
# Do not commit this file after you add values.

MONGODB_URI=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_USER_IDS=
APP_URL=

LLM_FREE_ONLY=true
# Cloud-first keeps free tiers for speed; Ollama is the last resort and gets a
# dedicated long budget, so quotas or provider outages do not block generation.
# A local-first install can swap these to LLM_PROVIDER=ollama with
# LLM_FALLBACK_PROVIDERS=groq,openrouter,mistral.
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDERS=openrouter,mistral,ollama
LLM_SEQUENCE_TIMEOUT_MS=300000

# Local Ollama (Gemma 3 4B) - last-resort local LLM. No API key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_MS=120000
# Story Draft generation on a 4B local model can spend several minutes in
# prompt_eval before the first output token. This dedicated budget (default
# 900 s) replaces the ordinary OLLAMA_TIMEOUT_MS for the story task only.
# OLLAMA_STORY_TIMEOUT_MS=900000
# Story Bible generation makes one request per section. This cap applies to a
# section attempt; the larger of it and OLLAMA_TIMEOUT_MS is used. Heavier
# sections (characters, canon) can take several minutes on a 4B CPU model.
# OLLAMA_SECTION_TIMEOUT_MS=300000
# Set OLLAMA_DISABLED=true (or OLLAMA_ENABLED=false) to make the local provider
# ineligible. If Ollama is still LLM_PROVIDER, select another primary instead.
# OLLAMA_ENDPOINT=/api/chat
# OLLAMA_TEMPERATURE=0.7
# OLLAMA_NUM_CTX=8192
# OLLAMA_SECTION_NUM_CTX=8192
# OLLAMA_TOP_P=0.9
# OLLAMA_REPEAT_PENALTY=1.1
# Story Bible sections always use their JSON schema and low-entropy sampling
# (temperature <= 0.2, top_p <= 0.8, repeat_penalty >= 1.3), because a 4B model
# can otherwise rename fields or loop inside one long JSON string.
# Use JSON-schema structured output for other stages too.
# OLLAMA_FORMAT=schema

# LM Studio — local OpenAI-compatible LLM server.
# Set LLM_TEST_MODE=lmstudio to make LM Studio the exclusive provider (no fallback).
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=qwen3-4b-instruct-2507
# LMSTUDIO_API_KEY=lm-studio
# LMSTUDIO_TIMEOUT_MS=900000
# LMSTUDIO_SECTION_TIMEOUT_MS=600000
# LMSTUDIO_STORY_TIMEOUT_MS=900000
# LMSTUDIO_ENABLED=true
# LLM_TEST_MODE=lmstudio

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
# Story Bible generation is six sequential section requests. This caps one
# OpenRouter attempt; the whole sequence is also bounded per section.
# OPENROUTER_TIMEOUT_MS=150000
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Ignored while LLM_FREE_ONLY is true. These providers bill separately.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

IMAGE_PROVIDER=mock
IMAGE_PROVIDER_API_KEY=
IMAGE_MODEL=
VIDEO_PROVIDER=mock
VIDEO_PROVIDER_API_KEY=
VIDEO_MODEL=
VIDEO_POLL_INTERVAL_MS=15000
VIDEO_OPERATION_TIMEOUT_MS=600000
AUDIO_PROVIDER=mock
AUDIO_PROVIDER_API_KEY=

# FFmpeg rendering. Set FFMPEG_PATH to the ffmpeg binary to enable real rendering.
# When unset, render jobs fail with ffmpeg_not_configured.
FFMPEG_PATH=
RENDER_TIMEOUT_MS=1800000
RENDER_CONCURRENCY=1

# Optional per-project cost limit in cents. Null/unset = unlimited.
COST_LIMIT_DEFAULT_CENTS=
# Override upload size ceiling (defaults to per-type limits).
MEDIA_UPLOAD_MAX_BYTES=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional development media storage. Only the local adapter is implemented.
MEDIA_STORAGE_PROVIDER=
MEDIA_LOCAL_STORAGE_DIR=./storage/media
FFPROBE_PATH=
REDIS_URL=
# MCP server — exposes project data to external AI assistants via Model Context Protocol.
# Set MCP_ACTOR_USER_ID to the Clerk user ID that owns the projects to access.
# Start the server with: npm run mcp:server
# MCP_ACTOR_USER_ID=
