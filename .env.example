# Free-only story generation is the default. Paid providers are not called unless LLM_FREE_ONLY=false.
# Each provider needs its own key. A free tier still has rate limits and can be exhausted.
# Do not commit this file after you add values.

MONGODB_URI=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_USER_IDS=
APP_URL=

LLM_FREE_ONLY=true
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=groq,openrouter,mistral
LLM_SEQUENCE_TIMEOUT_MS=120000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Ignored while LLM_FREE_ONLY is true. These providers bill separately.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

IMAGE_PROVIDER=bfl
IMAGE_PROVIDER_API_KEY=
IMAGE_MODEL=
VIDEO_PROVIDER=ltx
VIDEO_PROVIDER_API_KEY=
VIDEO_MODEL=
VIDEO_INFERENCE_BASE_URL=
AUDIO_PROVIDER=kokoro
AUDIO_PROVIDER_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
REDIS_URL=
